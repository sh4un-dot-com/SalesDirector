{
  "name": "salesdirector",
  "version": "1.0.0",
  "description": "SalesDirector desktop app",
  "author": "Akita Engineering <support@akitaengineering.com> (https://www.akitaengineering.com)",
  "homepage": "https://github.com/sh4un-dot-com/SalesDirector",
  "repository": {
    "type": "git",
    "url": "https://github.com/sh4un-dot-com/SalesDirector.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start:desktop": "npm run build:web && electron .",
    "dist:linux": "npm run build:web && electron-builder --linux AppImage flatpak rpm pacman --publish never",
    "dist:linux:ci": "npm run build:web && electron-builder --linux AppImage rpm pacman --publish never",
    "dist:linux:flatpak": "electron-builder --linux flatpak --publish never",
    "dist:appimage": "npm run build:web && electron-builder --linux AppImage --publish never",
    "dist:flatpak": "npm run build:web && electron-builder --linux flatpak --publish never",
    "dist:rpm": "npm run build:web && electron-builder --linux rpm --publish never",
    "dist:pacman": "npm run build:web && electron-builder --linux pacman --publish never",
    "dist:mac": "npm run build:web && electron-builder --mac dmg --publish never",
    "dist:mac:ci": "npm run build:web && electron-builder --mac dmg --publish never",
    "dist:mac:signed": "npm run build:web && electron-builder --mac dmg --publish never",
    "dist:win": "npm run build:web && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.akitaengineering.salesdirector",
    "productName": "SalesDirector",
    "copyright": "Copyright © 2026 Akita Engineering. Made in Niagara Falls, Canada.",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "flatpak",
        "rpm",
        "pacman"
      ],
      "category": "Office",
      "packageCategory": "Office",
      "synopsis": "AI-assisted CRM, outreach, and sales workflow desktop app",
      "maintainer": "Akita Engineering <support@akitaengineering.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "executableName": "salesdirector"
    },
    "flatpak": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "runtimeVersion": "23.08",
      "baseVersion": "23.08",
      "useWaylandFlags": true
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-Setup.${ext}"
    }
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "imapflow": "^1.3.1",
    "lucide-react": "^0.462.0",
    "mailparser": "^3.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}
